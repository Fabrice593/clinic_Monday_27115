{
  "info": {
    "name": "Clinic Management System - Queries (set 2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:1015" },
    { "key": "doctorId", "value": "492a39de-7630-47c2-bdff-b0b4642c7de6" },
    { "key": "patientId", "value": "fd858a31-4f9a-4330-804a-5f70476a1da0" },
    { "key": "officeId", "value": "1a3903bc-6a8f-4b8d-8bf7-3d336bdefc3c" },
    { "key": "newAppointmentId", "value": "set-by-the-find-request" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "List doctors (doctorId is already set to Marie Uwimana)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/doctor/all" }
        },
        {
          "name": "Create patient - Alice Murekatete",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Murekatete\",\n  \"ssNumber\": \"1006\"\n}" },
            "url": "{{baseUrl}}/api/patient/save"
          }
        },
        {
          "name": "Create appointment - Emmanuel Niyonzima, 2026-11-05",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"patient\": { \"id\": \"fbb88d8a-14bb-4a6a-bcb8-17cdb28cb123\" },\n  \"doctor\": { \"id\": \"{{doctorId}}\" },\n  \"appointmentDate\": \"2026-11-05T10:30:00\",\n  \"reason\": \"Blood pressure follow-up\"\n}" },
            "url": "{{baseUrl}}/api/appointment/save"
          }
        },
        {
          "name": "Create appointment - Josiane Mutoni, 2026-11-12",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"patient\": { \"id\": \"c68ed321-dfcd-4a9e-9e17-687846de428b\" },\n  \"doctor\": { \"id\": \"{{doctorId}}\" },\n  \"appointmentDate\": \"2026-11-12T14:00:00\",\n  \"reason\": \"Dental check\"\n}" },
            "url": "{{baseUrl}}/api/appointment/save"
          }
        },
        {
          "name": "Create appointment - Thierry Bizimana, 2026-12-03",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"patient\": { \"id\": \"4743eb0e-5f6f-4106-903d-008a22832a6c\" },\n  \"doctor\": { \"id\": \"{{doctorId}}\" },\n  \"appointmentDate\": \"2026-12-03T09:15:00\",\n  \"reason\": \"Eye test\"\n}" },
            "url": "{{baseUrl}}/api/appointment/save"
          }
        },
        {
          "name": "Find Emmanuel's 2026-11-05 appointment (saves its id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// keep the id of the appointment created above for the next request",
                  "const list = pm.response.json();",
                  "const found = Array.isArray(list) && list.find(a => a.patient.id === 'fbb88d8a-14bb-4a6a-bcb8-17cdb28cb123' && a.doctor.id === pm.collectionVariables.get('doctorId'));",
                  "if (found) { pm.collectionVariables.set('newAppointmentId', found.id); }"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/between?start=2026-11-05&end=2026-11-05", "host": ["{{baseUrl}}"], "path": ["api","appointments","between"], "query": [{ "key": "start", "value": "2026-11-05" }, { "key": "end", "value": "2026-11-05" }] } }
        },
        {
          "name": "Set status CONFIRMED (the appointment found above)",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/appointments/{{newAppointmentId}}/status?status=CONFIRMED", "host": ["{{baseUrl}}"], "path": ["api","appointments","{{newAppointmentId}}","status"], "query": [{ "key": "status", "value": "CONFIRMED" }] }
          }
        }
      ]
    },
    {
      "name": "A1 Patients by last name",
      "item": [
        {
          "name": "mutoni (lowercase)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=mutoni", "host": ["{{baseUrl}}"], "path": ["api","patients","by-last-name"], "query": [{ "key": "lastName", "value": "mutoni" }] } }
        },
        {
          "name": "NIYONZIMA (uppercase)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=NIYONZIMA", "host": ["{{baseUrl}}"], "path": ["api","patients","by-last-name"], "query": [{ "key": "lastName", "value": "NIYONZIMA" }] } }
        },
        {
          "name": "BiZiMaNa (mixed case)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=BiZiMaNa", "host": ["{{baseUrl}}"], "path": ["api","patients","by-last-name"], "query": [{ "key": "lastName", "value": "BiZiMaNa" }] } }
        },
        {
          "name": "Habimana (no match -> [])",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=Habimana", "host": ["{{baseUrl}}"], "path": ["api","patients","by-last-name"], "query": [{ "key": "lastName", "value": "Habimana" }] } }
        }
      ]
    },
    {
      "name": "A2 Appointments by status",
      "item": [
        {
          "name": "SCHEDULED",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/by-status?status=SCHEDULED", "host": ["{{baseUrl}}"], "path": ["api","appointments","by-status"], "query": [{ "key": "status", "value": "SCHEDULED" }] } }
        },
        {
          "name": "CONFIRMED",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/by-status?status=CONFIRMED", "host": ["{{baseUrl}}"], "path": ["api","appointments","by-status"], "query": [{ "key": "status", "value": "CONFIRMED" }] } }
        },
        {
          "name": "cancelled (lowercase)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/by-status?status=cancelled", "host": ["{{baseUrl}}"], "path": ["api","appointments","by-status"], "query": [{ "key": "status", "value": "cancelled" }] } }
        },
        {
          "name": "PENDING (invalid -> 400)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/by-status?status=PENDING", "host": ["{{baseUrl}}"], "path": ["api","appointments","by-status"], "query": [{ "key": "status", "value": "PENDING" }] } }
        }
      ]
    },
    {
      "name": "A3 Appointments between dates",
      "item": [
        {
          "name": "November 2026",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/between?start=2026-11-01&end=2026-11-30", "host": ["{{baseUrl}}"], "path": ["api","appointments","between"], "query": [{ "key": "start", "value": "2026-11-01" }, { "key": "end", "value": "2026-11-30" }] } }
        },
        {
          "name": "Single day 2026-11-12",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/between?start=2026-11-12&end=2026-11-12", "host": ["{{baseUrl}}"], "path": ["api","appointments","between"], "query": [{ "key": "start", "value": "2026-11-12" }, { "key": "end", "value": "2026-11-12" }] } }
        },
        {
          "name": "Nov 5 to Dec 3 (inclusive edges)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/between?start=2026-11-05&end=2026-12-03", "host": ["{{baseUrl}}"], "path": ["api","appointments","between"], "query": [{ "key": "start", "value": "2026-11-05" }, { "key": "end", "value": "2026-12-03" }] } }
        },
        {
          "name": "End before start (-> 400)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/between?start=2026-12-01&end=2026-11-01", "host": ["{{baseUrl}}"], "path": ["api","appointments","between"], "query": [{ "key": "start", "value": "2026-12-01" }, { "key": "end", "value": "2026-11-01" }] } }
        },
        {
          "name": "Bad date format (-> 400)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/between?start=05-11-2026&end=2026-11-30", "host": ["{{baseUrl}}"], "path": ["api","appointments","between"], "query": [{ "key": "start", "value": "05-11-2026" }, { "key": "end", "value": "2026-11-30" }] } }
        }
      ]
    },
    {
      "name": "A4 One appointment per doctor per day",
      "item": [
        {
          "name": "Patrick with Uwimana on 2026-10-20 (already booked -> 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"patient\": { \"id\": \"{{patientId}}\" },\n  \"doctor\": { \"id\": \"{{doctorId}}\" },\n  \"appointmentDate\": \"2026-10-20T15:00:00\",\n  \"reason\": \"Follow up\"\n}" },
            "url": "{{baseUrl}}/api/appointments/save"
          }
        }
      ]
    },
    {
      "name": "B1 Doctors by specialization",
      "item": [
        {
          "name": "cardiology (lowercase)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/doctors/by-specialization?name=cardiology", "host": ["{{baseUrl}}"], "path": ["api","doctors","by-specialization"], "query": [{ "key": "name", "value": "cardiology" }] } }
        },
        {
          "name": "CARDIOLOGY (uppercase)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/doctors/by-specialization?name=CARDIOLOGY", "host": ["{{baseUrl}}"], "path": ["api","doctors","by-specialization"], "query": [{ "key": "name", "value": "CARDIOLOGY" }] } }
        },
        {
          "name": "Oncology (no match -> [])",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/doctors/by-specialization?name=Oncology", "host": ["{{baseUrl}}"], "path": ["api","doctors","by-specialization"], "query": [{ "key": "name", "value": "Oncology" }] } }
        }
      ]
    },
    {
      "name": "B2 Doctors without an office",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/doctors/without-office" }
    },
    {
      "name": "B3 Specializations nobody offers",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/specializations/unused" }
    },
    {
      "name": "B4 Patients of a doctor",
      "item": [
        {
          "name": "Marie Uwimana",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/patients/of-doctor/{{doctorId}}" }
        },
        {
          "name": "Unknown doctor (-> 404)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/patients/of-doctor/00000000-0000-0000-0000-000000000000" }
        }
      ]
    },
    {
      "name": "C1 Appointments per status",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/appointments/stats/by-status" }
    },
    {
      "name": "C2 Frequent patients",
      "item": [
        {
          "name": "min=3",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/patients/frequent?min=3", "host": ["{{baseUrl}}"], "path": ["api","patients","frequent"], "query": [{ "key": "min", "value": "3" }] } }
        },
        {
          "name": "min=2",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/patients/frequent?min=2", "host": ["{{baseUrl}}"], "path": ["api","patients","frequent"], "query": [{ "key": "min", "value": "2" }] } }
        }
      ]
    },
    {
      "name": "C3 Busiest office",
      "item": [
        {
          "name": "Setup - give office 101 a name",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cardiology Wing\",\n  \"officeNumber\": \"101\"\n}" },
            "url": "{{baseUrl}}/api/offices/update/{{officeId}}"
          }
        },
        {
          "name": "Busiest office",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/offices/busiest" }
        }
      ]
    },
    {
      "name": "C4 Doctor is absent - cancel Uwimana's 2026-11-17 (10-20 is kept for the Quiz 2 demo)",
      "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/api/appointments/cancel-day?doctorId={{doctorId}}&date=2026-11-17", "host": ["{{baseUrl}}"], "path": ["api","appointments","cancel-day"], "query": [{ "key": "doctorId", "value": "{{doctorId}}" }, { "key": "date", "value": "2026-11-17" }] } }
    },
    {
      "name": "Bonus",
      "item": [
        {
          "name": "Appointments page by page (page 0, 5 per page, newest first)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/page?page=0&size=5&sort=appointmentDate,desc", "host": ["{{baseUrl}}"], "path": ["api","appointments","page"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "5" }, { "key": "sort", "value": "appointmentDate,desc" }] } }
        },
        {
          "name": "Unknown sort property (-> 400)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/page?sort=colour,desc", "host": ["{{baseUrl}}"], "path": ["api","appointments","page"], "query": [{ "key": "sort", "value": "colour,desc" }] } }
        },
        {
          "name": "Clean cancellations before 2026-10-15",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/appointments/cancelled-before?date=2026-10-15", "host": ["{{baseUrl}}"], "path": ["api","appointments","cancelled-before"], "query": [{ "key": "date", "value": "2026-10-15" }] } }
        }
      ]
    }
  ]
}
